<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <horizontal id='main-horizontal' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='100' pref-height='70' pad-left='7' pad-top='1' child-align='UpperCenter' child-expand-width='false'>
    <vertical horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='9' pref-height='25' />
    <vertical active='~scores-active' horizontal-fit='PreferredSize' pref-width='80' pref-height='55' child-align='UpperCenter' child-expand-height='false' spacing='0'>
      <bsbr-list id='leaderboard' contents='leaderboard-contents' pref-number-cells='10' main-cell-size='6.5' />
    </vertical>
    <vertical active='~error-active' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='80' pref-height='50' child-align='MiddleCenter' child-expand-width='false' child-expand-height='false' spacing='1'>
      <text text='~error-title' align='Center' font-size='5' italics='true' pref-width='80' pref-height='7' />
      <text text='~error-text' align='Center' font-size='3.1' overflow-mode='Ellipsis' pref-width='80' pref-height='4.5' />
    </vertical>
  </horizontal>
  <page-button direction='Up' anchor-pos-x='-40' anchor-pos-y='4' active='~up-enabled' pref-width='5' on-click='up-clicked' />
  <page-button direction='Down' anchor-pos-x='-40' anchor-pos-y='-38' active='~down-enabled' pref-width='5' on-click='down-clicked' />
</bg>
