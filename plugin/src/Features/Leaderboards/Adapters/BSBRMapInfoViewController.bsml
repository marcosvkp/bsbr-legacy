<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <horizontal active='~info-active' bg='round-rect-panel' bg-color='#000000a0' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='95' pref-height='22' pad-left='2' pad-right='2' pad-top='1' pad-bottom='1' spacing='1'>
    <vertical horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='9' pref-height='9'>
      <raw-image image='~map-cover' preserve-aspect='true' horizontal-fit='Fill' vertical-fit='Fill' />
    </vertical>
    <vertical horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='80' pref-height='20' pad-top='1' spacing='0'>
      <text text='~map-title' font-size='3.4' italics='true' align='Left' overflow-mode='Ellipsis' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' />
      <text text='~map-stars' font-size='2.5' rich-text='true' align='Left' overflow-mode='Ellipsis' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' />
      <text text='~map-meta' font-size='2.2' rich-text='true' align='Left' overflow-mode='Ellipsis' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' />
    </vertical>
  </horizontal>
</bg>
