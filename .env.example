# ── Portas expostas na sua máquina ──────────────────────────────────────────
# API_PORT diferente de 8000 se a porta estiver ocupada (o front é rebuildado
# apontando para http://localhost:$API_PORT/api/v1 automaticamente)
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Painel admin (header X-Admin-Token) ─────────────────────────────────────
ADMIN_TOKEN=

# Segredo que assina os cookies de sessão (admin + usuários do site).
# Recomendado: `openssl rand -hex 32`. Sem ele o backend usa fallbacks
# conhecidos — defina um valor forte em produção.
SESSION_SECRET=

# ── OAuth Steam (login de usuários do site) ─────────────────────────────────
# API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# URL pública do frontend (redirect pós-login).
FRONTEND_BASE_URL=http://localhost:3000
# Callback exato do OpenID Steam. A porta segue o API_PORT (dev local:
# http://localhost:18000/api/v1/auth/steam/callback; prod: https://bsbr.pro/...)
STEAM_RETURN_TO=http://localhost:18000/api/v1/auth/steam/callback

# ── Integrações opcionais ───────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=

# ── Dev local SEM Docker (o compose já injeta os valores de serviço) ────────
# DATABASE_URL=postgresql+asyncpg://bsbr:bsbr@localhost:5432/bsbr
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
