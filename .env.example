# ── Portas expostas na sua máquina ──────────────────────────────────────────
# API_PORT diferente de 8000 se a porta estiver ocupada (o front é rebuildado
# apontando para http://localhost:$API_PORT/api/v1 automaticamente)
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Painel admin (header X-Admin-Token) ─────────────────────────────────────
ADMIN_TOKEN=

# ── Integrações opcionais ───────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=

# ── Dev local SEM Docker (o compose já injeta os valores de serviço) ────────
# DATABASE_URL=postgresql+asyncpg://bsbr:bsbr@localhost:5432/bsbr
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
